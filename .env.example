# Copie este arquivo para .env e preencha só o que for usar:
#   cp .env.example .env
# O .env nunca vai pro git; este aqui sim, e é o mapa de toda a configuração.

# ---------- resumo da ata (reuniao_resumo.py) ----------
# Chave da API LLM (quebragalho). Obrigatória só para gerar o resumo; sem ela a ata sai igual.
QUEBRAGALHO_API_KEY=

# ---------- re-transcrição via nuvem (transcrever --groq) ----------
# Opcional; sem ela o --groq avisa e sai. Transcrição local é o padrão.
GROQ_API_KEY=

# ---------- ajustes finos (opcional) ----------
# Modelo do resumo (padrão: qwen3.8-omni-flash, com muse-spark-1.3-contributor de fallback).
# Definir QG_MODELO pinia o modelo e desliga o fallback.
# QG_MODELO=qwen3.8-omni-flash

# Teto de caracteres por chamada ao LLM ao fatiar atas longas (padrão 16000, piso 4000).
# SUMMARY_CHUNK_CHARS=16000

# Microfone do modo reunião. Aceita NOME como aparece em `python reuniao.py dispositivos`
# (recomendado: sobrevive a troca de ordem USB; em nome duplicado, use a forma com [API])
# ou índice numérico. Vazio = mic padrão do Windows.
# REUNIAO_MIC=1

# Hotkeys do gravador (o ditador usa Ctrl+Alt+E / Ctrl+Alt+Q independentemente).
# REUNIAO_HOTKEY_GRAVAR=ctrl+alt+r
# REUNIAO_HOTKEY_SAIR=ctrl+alt+w

# Ditador: NOME do microfone, como aparece em `python reuniao.py dispositivos`
# (aceita índice também). Vazio = padrão do Windows. Escolher na bandeja grava aqui sozinho.
# VOSK_MIC=

# Ditador: modelo Whisper local (padrão medium; large-v3-turbo = melhor pt e
# até mais rápido; small/base/tiny = mais rápido, pior pt).
# DITADOR_MODEL=medium

# Legado do vosk_live.py: id do dispositivo de entrada (padrão 21) e pasta do modelo.
# O ditador Whisper ignora as duas.
# VOSK_DEVICE=21
# VOSK_MODEL=models/vosk-model-small-pt-0.3

# ---------- Obsidian (exportação; obsidian_export.py) ----------
# Pasta do vault. VAZIO = exportação desabilitada (o resto da cadeia funciona igual).
# OBSIDIAN_VAULT=
# Exemplo (vault no OneDrive):
# OBSIDIAN_VAULT=C:/Users/eduar/OneDrive/Documentos/Diario

# Pastas dentro do vault (criadas se não existirem) e template da Daily.
# OBSIDIAN_FOLDER=Trabalho/Reuniões
# OBSIDIAN_DAILY_FOLDER=Daily
# OBSIDIAN_DAILY_TEMPLATE=Templates/Daily.md

# ---------- diarização (--diarizar) ----------
# O token da Hugging Face NÃO vai no .env: rode `huggingface-cli login` uma vez
# e aceite os termos dos repos pyannote/speaker-diarization-community-1 e pyannote/segmentation-3.0.
# Depende do requirements-diarizacao.txt (opcional).

# ---------- comandos de voz (cérebro JEV via OpenRouter) ----------
# Palavra de ativação ("computador, pausar música"); sem ela tudo é ditado.
# COMANDO_WAKE=computador
# Confiança mínima do JEV p/ executar (0–1); abaixo disso vira ditado.
# COMANDO_CONFIANCA=0.6
# Modelo de decisão (fixo p/ limiares estáveis).
# JEV_MODEL=typesafe/jev-1.13
# Chave do OpenRouter (só p/ comandos fora do match local; sem ela, mídia local segue offline).
# OPENROUTER_API_KEY=
# Falar o status dos comandos (0 = mudo).
# COMANDO_VOZ=1
