# Copie este arquivo para .env e preencha só o que for usar:
#   cp .env.example .env
# O .env nunca vai pro git; este aqui sim, e é o mapa de toda a configuração.

# ---------- resumo da ata (reuniao_resumo.py) ----------
# Chave da API LLM (quebragalho). Obrigatória só para gerar o resumo; sem ela a ata sai igual.
QUEBRAGALHO_API_KEY=

# ---------- re-transcrição via nuvem (transcrever --groq) ----------
# Opcional; sem ela o --groq avisa e sai. Transcrição local é o padrão.
GROQ_API_KEY=

# ---------- ajustes finos (opcional) ----------
# Modelo do resumo (padrão: qwen3.8-omni-flash, com muse-spark-1.3-contributor de fallback).
# Definir QG_MODELO pinia o modelo e desliga o fallback.
# QG_MODELO=qwen3.8-omni-flash

# Id do microfone p/ o modo reunião, como aparece no sounddevice (padrão: mic padrão do Windows).
# REUNIAO_MIC=1

# Hotkeys do gravador (o ditador usa Ctrl+Alt+E / Ctrl+Alt+Q independentemente).
# REUNIAO_HOTKEY_GRAVAR=ctrl+alt+r
# REUNIAO_HOTKEY_SAIR=ctrl+alt+w

# Ditador: id do dispositivo de entrada (padrão 21 = AirPods WASAPI 16k) e pasta do modelo p/ vosk_live.
# VOSK_DEVICE=21
# VOSK_MODEL=models/vosk-model-small-pt-0.3

# ---------- diarização (--diarizar) ----------
# O token da Hugging Face NÃO vai no .env: rode `huggingface-cli login` uma vez
# e aceite os termos dos repos pyannote/speaker-diarization-community-1 e pyannote/segmentation-3.0.
